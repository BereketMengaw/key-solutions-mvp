/**
 * Writes design/tokens.css — the Tailwind v4 `@theme` built from design/tokens.ts.
 *
 *   node design/build-tokens-css.mts           # regenerate design/tokens.css
 *   node design/build-tokens-css.mts --check   # exit 1 if tokens.css is out of date
 *
 * Needs Node 22.18+ (runs .ts directly, no packages). See design/web-tailwind.md.
 * Naming is mechanical: camelCase token keys become kebab-case, e.g.
 *   colors.textMuted          → --color-text-muted          → text-text-muted
 *   statusColors.lowStock.fg  → --color-status-low-stock-fg → text-status-low-stock-fg
 *   size.iconSm               → --spacing-icon-sm           → size-icon-sm
 */

import { readFileSync, writeFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

import {
  categoryTints,
  colors,
  fontFamily,
  fontSize,
  fontWeight,
  lineHeight,
  radius,
  shadows,
  size,
  spacing,
  statusColors,
  statusSolid,
  touch,
  webBreakpoints,
} from './tokens.ts';

const kebab = (key: string): string => key.replace(/([a-z0-9])([A-Z])/g, '$1-$2').toLowerCase();
const px = (n: number): string => `${n}px`;

const lines: string[] = [];
const section = (title: string): void => {
  lines.push('', `  /* ${title} */`);
};
const add = (name: string, value: string): void => {
  lines.push(`  --${name}: ${value};`);
};

// Remove Tailwind's defaults so only token-backed classes exist (no bg-red-500, no p-7).
for (const ns of ['color', 'spacing', 'text', 'font-weight', 'radius', 'shadow', 'breakpoint', 'font']) {
  add(`${ns}-*`, 'initial');
}

section('colors');
for (const [k, v] of Object.entries(colors)) add(`color-${kebab(k)}`, v);
for (const [status, pair] of Object.entries(statusColors)) {
  add(`color-status-${kebab(status)}-bg`, pair.bg);
  add(`color-status-${kebab(status)}-fg`, pair.fg);
}
for (const [status, solid] of Object.entries(statusSolid)) {
  add(`color-solid-${kebab(status)}-bg`, solid.bg);
  add(`color-solid-${kebab(status)}-pressed`, solid.pressed);
  add(`color-solid-${kebab(status)}-fg`, solid.fg);
}
categoryTints.forEach((tint, i) => {
  add(`color-tint-${i + 1}-bg`, tint.bg);
  add(`color-tint-${i + 1}-fg`, tint.fg);
});
add('color-transparent', 'transparent');
add('color-current', 'currentColor');

section('spacing scale (p-4 = spacing[4]) and fixed sizes (w-sidebar, size-icon, h-min-target)');
for (const [k, v] of Object.entries(spacing)) add(`spacing-${k}`, px(v));
for (const [k, v] of Object.entries(size)) add(`spacing-${kebab(k)}`, px(v));
for (const [k, v] of Object.entries(touch)) add(`spacing-${kebab(k)}`, px(v));

section('type: text-md sets font size and its line height together');
// next/font sets --font-noto on <html>; the literal names are the fallback.
// The var() needs a fallback: an unset var without one voids the whole font-family.
const families = fontFamily.sans.map((f) => (f.includes(' ') ? `'${f}'` : f));
add('font-sans', [`var(--font-noto, ${families[0]})`, ...families.slice(1)].join(', '));
for (const [k, v] of Object.entries(fontSize)) {
  add(`text-${k}`, px(v));
  add(`text-${k}--line-height`, px(lineHeight[k as keyof typeof lineHeight]));
}
for (const [k, v] of Object.entries(fontWeight)) add(`font-weight-${k}`, v);

section('radius, shadow, breakpoints');
for (const [k, v] of Object.entries(radius)) add(`radius-${k}`, px(v));
for (const [k, v] of Object.entries(shadows)) add(`shadow-${k}`, v.css);
for (const [k, v] of Object.entries(webBreakpoints)) add(`breakpoint-${k}`, px(v));

const css = [
  '/* GENERATED by design/build-tokens-css.mts from design/tokens.ts. Do not edit by hand. */',
  '/* Import after tailwindcss: @import "tailwindcss"; @import "<path>/design/tokens.css"; */',
  '',
  '@theme static {',
  ...lines,
  '}',
  '',
].join('\n');

const outPath = fileURLToPath(new URL('./tokens.css', import.meta.url));

if (process.argv.includes('--check')) {
  let current = '';
  try {
    current = readFileSync(outPath, 'utf8');
  } catch {
    // Missing file counts as out of date.
  }
  if (current !== css) {
    console.error('design/tokens.css is out of date. Run: node design/build-tokens-css.mts');
    process.exit(1);
  }
  console.log('design/tokens.css is up to date.');
} else {
  writeFileSync(outPath, css);
  console.log('Wrote design/tokens.css');
}
